# Firebase Web SDK (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only secrets
INVENTORY_ENCRYPTION_KEY_BASE64=
APP_BASE_URL=https://your-domain.example

# SePay - choose the webhook auth mode you configure in SePay.
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=LV

# NAPPay Charging v2 - official adapter uses partner_id/partner_key.
NAPPAY_PARTNER_ID=
NAPPAY_PARTNER_KEY=
NAPPAY_ENDPOINT=https://nappay.vn/chargingws/v2

# Optional hardening
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

NEXT_PUBLIC_SITE_URL=
